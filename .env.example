# Ortam değişkenleri (örnek). Gerçek değerler .env.local'de; .env.local repoya girmez.
# `npm run db:seed` boş bırakılan yönetici bilgilerini ve SESSION_SECRET'ı üretip .env.local'e yazar.

# Sitenin kök adresi (canonical, sitemap, hreflang)
NEXT_PUBLIC_SITE_URL=https://ozteknikoto.com

# İlk yönetici (yalnız yerel geliştirme; canlıda değiştirin). 2FA zorunlu.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_TOTP_SECRET=

# Oturum çerezi imzası (en az 32 bayt rastgele)
SESSION_SECRET=

# IndexNow anahtarı (public/<anahtar>.txt ile aynı)
INDEXNOW_KEY=

# Google Analytics 4 (yalnız çerez onayından sonra yüklenir)
NEXT_PUBLIC_GA_ID=

# Test ortamı: SITE_ENV=staging → noindex + parola koruması
SITE_ENV=
STAGING_PASSWORD=

# SQLite dosyası (varsayılan data/ozteknik.db)
DB_PATH=
